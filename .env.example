# ==========================================================
# K.E.S. Smt. J.R.H. Kanyashala — website configuration
# Copy this file to `.env` and fill in the values.
# ==========================================================

# MongoDB connection (local MongoDB service by default)
MONGODB_URI=mongodb://127.0.0.1:27017/kes_kanyashala

# Port for the API server (must match the proxy in vite.config.ts)
API_PORT=5000

# Long random text used to sign admin logins. Change it to anything secret.
JWT_SECRET=change-me-to-a-long-random-string

# First admin account — created automatically the first time the server starts.
# The password can be changed later from the dashboard (School Information → Change password).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
